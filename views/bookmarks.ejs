<!DOCTYPE html>
<html>
<head>
    <title>Bookmarks - Movie App</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            background-color: #f2f6fc;
        }

        .movie-card {
            margin-bottom: 25px;
        }

        .movie-card img {
            height: 250px;
            object-fit: cover;
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a href="/usermovies" class="navbar-brand">
                Movie App
            </a>

            <a href="/logout" class="btn btn-danger">
                Logout
            </a>
        </div>
    </nav>

    <div class="container mt-4">
        <h2 class="text-center mb-4">
            My Bookmarks
        </h2>

        <% if (movies.length === 0) { %>
            <p class="text-center">
                No bookmarked movies found.
            </p>
        <% } %>

        <div class="row">
            <% movies.forEach(movie => { %>
                <div class="col-md-4 movie-card">
                    <div class="card shadow">
                        <img
                            src="/images/<%= movie.image %>"
                            class="card-img-top"
                            alt="<%= movie.title %>"
                        >

                        <div class="card-body">
                            <h5 class="card-title">
                                <%= movie.title %>
                            </h5>

                            <p>
                                <%= movie.description %>
                            </p>

                            <a
                                href="/movie/<%= movie._id %>"
                                class="btn btn-primary"
                            >
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

        <a href="/usermovies" class="btn btn-secondary">
            Back to Movies
        </a>
    </div>
</body>
</html>