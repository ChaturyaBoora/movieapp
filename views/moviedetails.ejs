<!DOCTYPE html>
<html>
<head>
    <title>Movie Details</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            background-color: #f2f6fc;
        }

        .details-box {
            max-width: 700px;
            margin: 40px auto;
        }

        .details-box img {
            width: 100%;
            max-height: 400px;
            object-fit: cover;
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a href="/usermovies" class="navbar-brand">
                Movie App
            </a>

            <a href="/logout" class="btn btn-danger">
                Logout
            </a>
        </div>
    </nav>

    <div class="container">
        <div class="card details-box shadow">
            <img
                src="/images/<%= movie.image %>"
                alt="<%= movie.title %>"
            >

            <div class="card-body">
                <h2><%= movie.title %></h2>

                <p>
                    <strong>Genre:</strong>
                    <%= movie.genre %>
                </p>

                <p>
                    <strong>Year:</strong>
                    <%= movie.year %>
                </p>

                <p>
                    <strong>Description:</strong>
                    <%= movie.description %>
                </p>

                <hr>

                <h4>Reviews</h4>

                <% if (movie.reviews && movie.reviews.length > 0) { %>
                    <% movie.reviews.forEach(item => { %>
                        <div class="border rounded p-2 mb-2">
                            <strong><%= item.username %></strong>
                            <p><%= item.review %></p>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p>No reviews yet.</p>
                <% } %>

                <hr>

                <h4>Add Review</h4>

                <form action="/review/<%= movie._id %>" method="POST">
    <input 
        type="number" 
        name="rating" 
        class="form-control mb-2" 
        placeholder="Rating (1-5)" 
        min="1" 
        max="5" 
        required
    >
    <textarea
        name="review"
        class="form-control mb-3"
        placeholder="Write your review"
        required
    ></textarea>

    <button type="submit" class="btn btn-success">
        Submit Review
    </button>
</form>

                <a href="/usermovies" class="btn btn-secondary mt-3">
                    Back to Movies
                </a>
            </div>
        </div>
    </div>
</body>
</html>