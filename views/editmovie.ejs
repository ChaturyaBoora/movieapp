<!DOCTYPE html>
<html>
<head>
    <title>Edit Movie</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            background-color: lightblue;
        }

        .container-box {
            max-width: 500px;
            margin: 50px auto;
            background-color: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 0 10px gray;
        }
    </style>
</head>

<body>
    <div class="container-box">
        <h2 class="text-center mb-4">
            Edit Movie
        </h2>

        <form action="/editmovie/<%= movie._id %>" method="POST">
            <div class="mb-3">
                <label>Image Filename</label>
                <input
                    type="text"
                    name="image"
                    class="form-control"
                    value="<%= movie.image %>"
                    required
                >
            </div>
            <div class="mb-3">
                <label>Movie Title</label>
                <input
                    type="text"
                    name="title"
                    class="form-control"
                    value="<%= movie.title %>"
                    required
                >
            </div>

            <div class="mb-3">
                <label>Genre</label>
                <input
                    type="text"
                    name="genre"
                    class="form-control"
                    value="<%= movie.genre %>"
                    required
                >
            </div>

            <div class="mb-3">
                <label>Release Year</label>
                <input
                    type="number"
                    name="year"
                    class="form-control"
                    value="<%= movie.year %>"
                    required
                >
            </div>

            <div class="mb-3">
                <label>Description</label>
                <textarea
                    name="description"
                    class="form-control"
                    required
                ><%= movie.description %></textarea>
            </div>

            <button type="submit" class="btn btn-primary">
                Update Movie
            </button>

            <a href="/admin" class="btn btn-secondary">
                Cancel
            </a>
        </form>
    </div>
</body>
</html>