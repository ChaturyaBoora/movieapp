<!DOCTYPE html>
<html>
<head>
    <title>Movies - Movie App</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

<style>
        body {
            background-color: #141414;
            color: #ffffff;
        }

        /* Navbar tweaks */
        .navbar {
            border-bottom: 3px solid #e50914;
            background-color: #000000 !important;
        }

        .navbar-brand {
            color: #f5c518 !important;
            font-weight: bold;
        }

        h2.text-center {
            color: #f5c518;
            font-weight: bold;
            margin-top: 10px;
        }

        /* Movie Card Styling */
        .movie-card {
            margin-bottom: 30px;
        }

        .card {
            background-color: #222222;
            border: none;
            border-bottom: 4px solid #e50914;
            border-radius: 8px;
            color: #ffffff;
            box-shadow: 0 8px 16px rgba(0,0,0,0.5);
            transition: transform 0.2s ease;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .card-img-top {
            height: 350px; /* Made taller for standard movie posters */
            object-fit: cover;
            background-color: #333333; /* Dark gray placeholder for missing images */
            color: #aaaaaa;
        }

        .card-body p {
            color: #cccccc;
        }

        /* Customizing the Bootstrap Buttons */
        .btn-primary {
            background-color: #e50914;
            border: none;
        }
        
        .btn-primary:hover {
            background-color: #b80710;
        }

        .btn-warning {
            background-color: #f5c518;
            border: none;
            color: #141414;
            font-weight: bold;
        }
        
        .btn-warning:hover {
            background-color: #d4a715;
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <span class="navbar-brand">
                Welcome to Movie App
            </span>

            <div>
                <a href="/bookmarks" class="btn btn-warning">
                    Bookmarks
                </a>

                <a href="/logout" class="btn btn-danger">
                    Logout
                </a>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <h2 class="text-center mb-4">
            Available Movies
        </h2>

        <div class="row">
            <% movies.forEach(movie => { %>
                <div class="col-md-4 movie-card">
                    <div class="card shadow">
                        <img
                            src="/images/<%= movie.image %>"
                            class="card-img-top"
                            alt="<%= movie.title %>"
                        >

                        <div class="card-body">
                            <h5 class="card-title">
                                <%= movie.title %>
                            </h5>

                            <p>
                                <strong>Genre:</strong>
                                <%= movie.genre %>
                            </p>

                            <p>
                                <strong>Year:</strong>
                                <%= movie.year %>
                            </p>

                            <p>
                                <%= movie.description %>
                            </p>

                            <a
                                href="/movie/<%= movie._id %>"
                                class="btn btn-primary"
                            >
                                View Details
                            </a>

                            <a
                                href="/bookmark/<%= movie._id %>"
                                class="btn btn-warning"
                            >
                                Bookmark
                            </a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</body>
</html>