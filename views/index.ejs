<!DOCTYPE html>
<html>
<head>
    <title>Admin - Movie App</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

<style>
        body {
            background-color: #141414;
            color: #ffffff;
        }

        /* Navbar tweaks */
        .navbar {
            border-bottom: 3px solid #e50914;
            background-color: #000000 !important;
        }

        .navbar-brand {
            color: #f5c518 !important;
            font-weight: bold;
        }

        /* Headers */
        h2 {
            color: #f5c518;
            font-weight: bold;
        }

        /* Movie Card Styling */
        .movie-card {
            margin-bottom: 30px;
        }

        .card {
            background-color: #222222;
            border: none;
            border-bottom: 4px solid #e50914;
            border-radius: 8px;
            color: #ffffff;
            box-shadow: 0 8px 16px rgba(0,0,0,0.5);
            transition: transform 0.2s ease;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .card-img-top {
            height: 350px; 
            object-fit: cover;
            background-color: #333333; 
            color: #aaaaaa;
        }

        .card-body p {
            color: #cccccc;
        }

        /* Customizing Buttons for the Theme */
        .btn-success {
            background-color: #f5c518;
            border: none;
            color: #141414;
            font-weight: bold;
        }
        
        .btn-success:hover {
            background-color: #d4a715;
            color: #141414;
        }

        .btn-warning {
            background-color: #444444;
            border: none;
            color: #ffffff;
        }

        .btn-warning:hover {
            background-color: #555555;
            color: #ffffff;
        }

        .btn-danger {
            background-color: #e50914;
            border: none;
        }

        .btn-danger:hover {
            background-color: #b80710;
        }
        
        .btn-light {
            background-color: #333333;
            border: 1px solid #555555;
            color: #ffffff;
        }
        
        .btn-light:hover {
            background-color: #444444;
            color: #ffffff;
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/admin">
                Movie App - Admin
            </a>

            <a href="/login" class="btn btn-light">
                Login Page
            </a>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Movie List</h2>

            <a href="/addmovie" class="btn btn-success">
                Add Movie
            </a>
        </div>

        <div class="row">
            <% movies.forEach(movie => { %>
                <div class="col-md-4 movie-card">
                    <div class="card shadow">
                        <img
    src="/images/<%= movie.image %>"
    class="card-img-top"
    alt="<%= movie.title %>"
>

                        <div class="card-body">
                            <h5 class="card-title">
                                <%= movie.title %>
                            </h5>

                            <p class="card-text">
                                <strong>Genre:</strong>
                                <%= movie.genre %>
                            </p>

                            <p class="card-text">
                                <strong>Year:</strong>
                                <%= movie.year %>
                            </p>

                            <p class="card-text">
                                <%= movie.description %>
                            </p>

                            <a
                                href="/editmovie/<%= movie._id %>"
                                class="btn btn-warning"
                            >
                                Edit
                            </a>

                            <a
                                href="/deletemovie/<%= movie._id %>"
                                class="btn btn-danger"
                                onclick="return confirm('Delete this movie?')"
                            >
                                Delete
                            </a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</body>
</html>