<!DOCTYPE html>
<html>
<head>
    <title>Add Movie</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            background-color: lightblue;
        }

        .container-box {
            max-width: 500px;
            margin: 50px auto;
            background-color: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 0 10px gray;
        }
    </style>
</head>

<body>
    <div class="mb-3">
                <label>Image Filename</label>
                <input
                    type="text"
                    name="image"
                    class="form-control"
                    placeholder="e.g., spidermandnd.jpg"
                    required
                >
            </div>
    <div class="container-box">
        <h2 class="text-center mb-4">
            Add Movie
        </h2>

        <form action="/addmovie" method="POST">
            <div class="mb-3">
                <label>Movie Title</label>
                <input
                    type="text"
                    name="title"
                    class="form-control"
                    required
                >
            </div>

            <div class="mb-3">
                <label>Genre</label>
                <input
                    type="text"
                    name="genre"
                    class="form-control"
                    required
                >
            </div>

            <div class="mb-3">
                <label>Release Year</label>
                <input
                    type="number"
                    name="year"
                    class="form-control"
                    required
                >
            </div>

            <div class="mb-3">
                <label>Description</label>
                <textarea
                    name="description"
                    class="form-control"
                    required
                ></textarea>
            </div>

            <button type="submit" class="btn btn-success">
                Add Movie
            </button>

            <a href="/admin" class="btn btn-secondary">
                Cancel
            </a>
        </form>
    </div>
</body>
</html>